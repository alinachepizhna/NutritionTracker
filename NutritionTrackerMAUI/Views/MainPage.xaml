<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:NutritionTrackerMAUI.Views"
            x:Class="NutritionTrackerMAUI.Views.MainPage"
            BarBackgroundColor="#D32F2F"
            BarTextColor="White"
            Title="Головна">

    <ContentPage Title="Головна" IconImageSource="home.png" BackgroundColor="#F0F0F5">
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="20">

                <Frame BorderColor="#D32F2F" CornerRadius="20" Padding="20" HasShadow="False" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ваша поточна ціль"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#D32F2F"
                               HorizontalOptions="Center"/>

                        <BoxView HeightRequest="2" Color="#F48FB1" WidthRequest="100" HorizontalOptions="Center"/>

                        <Label x:Name="CurrentGoalLabel" Text="Ціль: --" FontSize="16" TextColor="#333"/>
                        <Label x:Name="CurrentStrategyLabel" Text="Стратегія: --" FontSize="16" TextColor="#333"/>

                        <Button Text="Нова ціль"
                                BackgroundColor="#D32F2F"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="40"
                                Margin="0,10,0,0"
                                Clicked="OnNewGoalClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Календар тренувань" FontAttributes="Bold" FontSize="18" TextColor="#D32F2F" Margin="5,0"/>
                    <Button x:Name="ShowPlanButton"
        Text="Показати план"
        FontSize="12"
        HeightRequest="35"
        CornerRadius="8"
        Padding="0"
        BackgroundColor="#D32F2F"
        TextColor="White"
        Clicked="OnRefreshCalendarClicked"
        Margin="0,0,0,5"/>

                    <CollectionView x:Name="MiniCalendarCollection" 
                HeightRequest="75"
                SelectionMode="None">

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" 
                         Span="7" 
                         HorizontalItemSpacing="3" 
                         VerticalItemSpacing="0" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    BackgroundColor="{Binding BackgroundColor}"
                    Padding="0"
                    HeightRequest="70">

                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">

                                        <Label Text="{Binding DateText}"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalOptions="Center"
                           TextColor="White"/>

                                        <Label Text="{Binding WorkoutType}" 
                           FontSize="8" 
                           TextColor="White" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           Margin="1,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label x:Name="TodayWorkoutLabel" 
                           FontSize="15" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,5"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

</TabbedPage>