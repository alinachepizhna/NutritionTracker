<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:NutritionTrackerMAUI.Views"
            x:Class="NutritionTrackerMAUI.Views.MainPage"
            BarBackgroundColor="#D32F2F"
            BarTextColor="White"
            Title="Головна">

    <ContentPage Title="Головна" IconImageSource="home.png" BackgroundColor="#F0F0F5">
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="20">

                <Frame BorderColor="#D32F2F" CornerRadius="20" Padding="20" HasShadow="False" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ваша поточна ціль" FontSize="22" FontAttributes="Bold" TextColor="#D32F2F" HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="#F48FB1" WidthRequest="100" HorizontalOptions="Center"/>
                        <Label x:Name="CurrentGoalLabel" Text="Ціль: --" FontSize="16" TextColor="#333"/>
                        <Label x:Name="CurrentStrategyLabel" Text="Стратегія: --" FontSize="16" TextColor="#333"/>
                        <Button Text="Нова ціль" BackgroundColor="#D32F2F" TextColor="White" CornerRadius="10" HeightRequest="40" Margin="0,10,0,0" Clicked="OnNewGoalClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Margin="0,5" Padding="15" CornerRadius="15" HasShadow="True" BackgroundColor="{Binding RecommendationColor}">
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="🤖" FontSize="24"/>
                                <Label Text="{Binding RecommendationTitle}" FontAttributes="Bold" FontSize="18" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding RecommendationMessage}" TextColor="White" FontSize="14"/>
                        </VerticalStackLayout>

                        <Frame BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="False">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAddStepsClicked"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="👣 Кроки" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Text="{Binding CurrentSteps}" FontAttributes="Bold" FontSize="16" TextColor="#333" HorizontalOptions="Center"/>
                                    <Label Text="+ додати" FontSize="10" TextColor="#D32F2F" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAddWaterClicked"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="💧 Вода" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Text="{Binding CurrentWaterText}" FontAttributes="Bold" FontSize="16" TextColor="#333" HorizontalOptions="Center"/>
                                    <Label Text="+ мл" FontSize="10" TextColor="#1976D2" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSetSittingClicked"/>
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="🪑 Сидіння" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Text="{Binding CurrentSittingText}" FontAttributes="Bold" FontSize="16" TextColor="#333" HorizontalOptions="Center"/>
                                    <Label Text="змінити" FontSize="10" TextColor="#E64A19" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                            </Grid>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Календар тренувань" FontAttributes="Bold" FontSize="18" TextColor="#D32F2F" Margin="5,0"/>

                    <Button x:Name="ShowPlanButton" Text="Показати план" FontSize="12" HeightRequest="35" CornerRadius="8" Padding="0" BackgroundColor="#D32F2F" TextColor="White" Clicked="OnRefreshCalendarClicked" Margin="0,0,0,5"/>

                    <CollectionView x:Name="MiniCalendarCollection" HeightRequest="75" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="3" VerticalItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{Binding BackgroundColor}" Padding="0" HeightRequest="70">
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DateText}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" TextColor="White"/>
                                        <Label Text="{Binding WorkoutType}" FontSize="8" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" Margin="1,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label x:Name="TodayWorkoutLabel" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>
</TabbedPage>