<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionTrackerMAUI.Views.DietarySettingsPage"
             Title="Мої обмеження"
             BackgroundColor="#F0F0F5">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Які продукти ви хочете виключити?" 
               FontSize="18" 
               FontAttributes="Bold" 
               TextColor="#D32F2F"/>

        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15" BackgroundColor="White">
            <HorizontalStackLayout Spacing="15">
                <Switch IsToggled="{Binding AvoidGluten}" OnColor="#D32F2F"/>
                <Label Text="🚫 Глютен (Хліб, паста, злаки)" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15" BackgroundColor="White">
            <HorizontalStackLayout Spacing="15">
                <Switch IsToggled="{Binding AvoidLactose}" OnColor="#D32F2F"/>
                <Label Text="🥛 Лактоза (Молоко, сир)" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15" BackgroundColor="White">
            <HorizontalStackLayout Spacing="15">
                <Switch IsToggled="{Binding AvoidNuts}" OnColor="#D32F2F"/>
                <Label Text="🥜 Горіхи" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15" BackgroundColor="White">
            <HorizontalStackLayout Spacing="15">
                <Switch IsToggled="{Binding AvoidSugar}" OnColor="#D32F2F"/>
                <Label Text="🍬 Цукор/Фруктоза" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <Button Text="Зберегти налаштування" 
                BackgroundColor="#D32F2F" 
                TextColor="White" 
                CornerRadius="20" 
                HeightRequest="50" 
                Clicked="OnSaveClicked"/>
    </VerticalStackLayout>
</ContentPage>